{
  "manifestVersion": 2,
  "id": "asana-tasks",
  "name": "Asana Tasks",
  "version": "0.1.0",
  "description": "自分に割り当てられた Asana タスクをサイドバーに並べ、タスクからワークスペースを作って Claude に着手させる。",
  "engines": {
    "orca": ">=1.4.256"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "asana-tasks",
        "title": "Asana Tasks",
        "icon": "flag",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "secrets:own" },
    { "kind": "workspace:read" },
    { "kind": "workspace:write" }
  ]
}
